\f3\b\fs48 \cf3 4. That\cb1 \
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "https://github.com/hassande188-collab/product-vision.md/blob/main/product-vision.md#4-that"}}{\fldrslt 
